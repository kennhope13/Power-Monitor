# ============================================================
# StationOS Frontend — Biến môi trường
# Sao chép file này thành .env và điền giá trị thực
# ============================================================

# URL backend API (REST + SignalR hub)
VITE_API_URL=http://localhost:5000

# URL server AI Engine (FastAPI trên Jetson)
VITE_AI_ENGINE_URL=http://192.168.10.104:8080

# URL server go2rtc (stream camera RTSP → WebRTC)
VITE_GO2RTC_URL=http://localhost:1984

# Chế độ triển khai: 'onprem' (single-station) hoặc 'cloud' (multi-station)
# Khi là 'cloud', menu "Đa trạm" sẽ hiển thị trong sidebar
VITE_APP_MODE=onprem
