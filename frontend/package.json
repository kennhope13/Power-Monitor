{
    "name": "station-os",
    "private": true,
    "version": "3.0.56",
    "license": "UNLICENSED",
    "type": "module",
    "main": "electron/main.cjs",
    "description": "Station Monitor Thin Client desktop application",
    "author": "StationOS Team",
    "homepage": "https://github.com/kennhope13/App-Station-Monitor",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:full": "VITE_VARIANT=full tsc && VITE_VARIANT=full vite build",
        "build:tech": "VITE_VARIANT=tech tsc && VITE_VARIANT=tech vite build",
        "build:finance": "VITE_VARIANT=finance tsc && VITE_VARIANT=finance vite build",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview",
        "test:e2e:full": "VITE_VARIANT=full playwright test",
        "test:e2e:tech": "VITE_VARIANT=tech playwright test",
        "test:e2e:finance": "VITE_VARIANT=finance playwright test",
        "test:e2e:runtime": "VITE_VARIANT=full playwright test e2e/runtime-fetch.spec.ts",
        "test:e2e": "npm run test:e2e:runtime && npm run test:e2e:full && npm run test:e2e:tech && npm run test:e2e:finance",
        "electron:dev": "electron .",
        "electron:build": "npm run build && electron-builder build",
        "electron:build:win": "npm run build && electron-builder build --windows",
        "electron:build:linux": "npm run build && electron-builder build --linux"
    },
    "devDependencies": {
        "@playwright/test": "^1.52.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "electron": "^41.7.1",
        "electron-builder": "^26.15.2",
        "esbuild": "^0.27.3",
        "markdownlint-cli2": "^0.20.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.13",
        "vite-plugin-pwa": "^1.2.0",
        "ws": "^8.19.0"
    },
    "dependencies": {
        "@microsoft/signalr": "^10.0.0",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "chartjs-plugin-zoom": "^2.2.0",
        "date-fns": "^4.1.0",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.7",
        "lucide-react": "^1.16.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-router-dom": "^7.15.1",
        "xlsx": "^0.18.5",
        "zustand": "^5.0.13"
    }
}
